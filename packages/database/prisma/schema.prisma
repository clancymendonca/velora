datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Sport {
  BASKETBALL
  FOOTBALL
  SOCCER
  BASEBALL
  TENNIS
  ESPORTS
}

enum EventStatus {
  SCHEDULED
  LIVE
  FINISHED
  SUSPENDED
  CANCELLED
}

enum BetStatus {
  PENDING
  WON
  LOST
  PUSH
  VOID
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  name           String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")
  settings       UserSettings?
  bets           Bet[]
  ledgerLogs     BankrollLedger[]
  snapshots      BankrollSnapshot[]
  simulationRuns SimulationRun[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  oddsFormat           String   @default("decimal") @map("odds_format")
  defaultStake         Decimal  @default(50.00) @map("default_stake") @db.Decimal(12, 2)
  riskTolerancePercent Decimal  @default(5.00) @map("risk_tolerance_percent") @db.Decimal(5, 2)
  kellyFraction        Decimal  @default(0.25) @map("kelly_fraction") @db.Decimal(4, 3)
  trackedBookmakers    String[] @default([]) @map("tracked_bookmakers")
  trackedSports        String[] @default([]) @map("tracked_sports")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model League {
  id        String    @id @default(uuid())
  sport     Sport
  name      String
  country   String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  events    Event[]

  @@index([sport, isActive])
  @@map("leagues")
}

model Event {
  id         String      @id @default(uuid())
  leagueId   String      @map("league_id")
  externalId String      @unique @map("external_id")
  homeTeam   String      @map("home_team")
  awayTeam   String      @map("away_team")
  startTime  DateTime    @map("start_time")
  status     EventStatus @default(SCHEDULED)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")
  league     League      @relation(fields: [leagueId], references: [id])
  markets    Market[]

  @@index([startTime, status])
  @@index([deletedAt])
  @@map("events")
}

model Bookmaker {
  id           String        @id @default(uuid())
  key          String        @unique
  name         String
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  markets      Market[]
  closingLines ClosingLine[]

  @@map("bookmakers")
}

model Market {
  id          String      @id @default(uuid())
  eventId     String      @map("event_id")
  bookmakerId String      @map("bookmaker_id")
  marketType  String      @map("market_type") // h2h, spreads, totals, props
  status      String      @default("open")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookmaker   Bookmaker   @relation(fields: [bookmakerId], references: [id])
  selections  Selection[]

  @@unique([eventId, bookmakerId, marketType])
  @@index([eventId, status])
  @@map("markets")
}

model Selection {
  id                 String        @id @default(uuid())
  marketId           String        @map("market_id")
  name               String
  priceDecimal       Decimal       @map("price_decimal") @db.Decimal(10, 4)
  priceAmerican      Int           @map("price_american")
  impliedProbability Decimal       @map("implied_probability") @db.Decimal(5, 4)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")
  market             Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  oddsHistory        OddsHistory[]
  parlayLegs         ParlayLeg[]
  closingLines       ClosingLine[]

  @@index([marketId])
  @@map("selections")
}

model OddsHistory {
  id            String    @id @default(uuid())
  selectionId   String    @map("selection_id")
  priceDecimal  Decimal   @map("price_decimal") @db.Decimal(10, 4)
  priceAmerican Int       @map("price_american")
  timestamp     DateTime  @default(now())
  selection     Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@index([selectionId, timestamp(sort: Desc)])
  @@map("odds_history")
}

model ClosingLine {
  id                   String    @id @default(uuid())
  selectionId          String    @map("selection_id")
  bookmakerId          String    @map("bookmaker_id")
  closingPriceDecimal  Decimal   @map("closing_price_decimal") @db.Decimal(10, 4)
  closingPriceAmerican Int       @map("closing_price_american")
  closingImpliedProb   Decimal   @map("closing_implied_prob") @db.Decimal(5, 4)
  timestamp            DateTime  @default(now())
  selection            Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  bookmaker            Bookmaker @relation(fields: [bookmakerId], references: [id])

  @@index([selectionId, timestamp(sort: Desc)])
  @@map("closing_lines")
}

model Bet {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  status        BetStatus        @default(PENDING)
  stake         Decimal          @db.Decimal(12, 2)
  oddsDecimal   Decimal          @map("odds_decimal") @db.Decimal(10, 4)
  expectedValue Decimal          @map("expected_value") @db.Decimal(6, 4)
  kellyApplied  Decimal          @map("kelly_applied") @db.Decimal(5, 4)
  placedAt      DateTime         @default(now()) @map("placed_at")
  settledAt     DateTime?        @map("settled_at")
  isParlay      Boolean          @default(false) @map("is_parlay")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")
  user          User?            @relation(fields: [userId], references: [id])
  legs          ParlayLeg[]
  ledgerLogs    BankrollLedger[]
  clv           ClvRecord?

  @@index([userId, status])
  @@index([placedAt(sort: Desc)])
  @@index([deletedAt])
  @@map("bets")
}

model ParlayLeg {
  id          String    @id @default(uuid())
  betId       String    @map("bet_id")
  selectionId String    @map("selection_id")
  status      BetStatus @default(PENDING)
  bet         Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  selection   Selection @relation(fields: [selectionId], references: [id])

  @@index([betId])
  @@map("parlay_legs")
}

model BankrollLedger {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  timestamp    DateTime @default(now())
  type         String   // DEPOSIT, WITHDRAWAL, BET_PLACE, BET_SETTLEMENT, ADJUSTMENT
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(12, 2)
  betId        String?  @map("bet_id")
  user         User?    @relation(fields: [userId], references: [id])
  bet          Bet?     @relation(fields: [betId], references: [id])

  @@index([userId, timestamp(sort: Desc)])
  @@map("bankroll_ledger")
}

model BankrollSnapshot {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  balance     Decimal  @db.Decimal(12, 2)
  netProfit   Decimal  @map("net_profit") @db.Decimal(12, 2)
  peakBalance Decimal  @map("peak_balance") @db.Decimal(12, 2)
  drawdown    Decimal  @db.Decimal(5, 4)
  timestamp   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId, timestamp(sort: Desc)])
  @@map("bankroll_snapshots")
}

model SimulationRun {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  initialBankroll     Decimal  @map("initial_bankroll") @db.Decimal(12, 2)
  winRate             Decimal  @map("win_rate") @db.Decimal(5, 4)
  averageOdds         Decimal  @map("average_odds") @db.Decimal(10, 4)
  numBets             Int      @map("num_bets")
  numSimulations      Int      @map("num_simulations")
  meanFinalBankroll   Decimal  @map("mean_final_bankroll") @db.Decimal(12, 2)
  medianFinalBankroll Decimal  @map("median_final_bankroll") @db.Decimal(12, 2)
  maxDrawdown95       Decimal  @map("max_drawdown_95") @db.Decimal(5, 4)
  riskOfRuin          Decimal  @map("risk_of_ruin") @db.Decimal(5, 4)
  createdAt           DateTime @default(now()) @map("created_at")
  user                User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("simulation_runs")
}

model ClvRecord {
  id                 String   @id @default(uuid())
  betId              String   @unique @map("bet_id")
  placedOddsDecimal  Decimal  @map("placed_odds_decimal") @db.Decimal(10, 4)
  closingOddsDecimal Decimal  @map("closing_odds_decimal") @db.Decimal(10, 4)
  clvPercent         Decimal  @map("clv_percent") @db.Decimal(6, 4)
  createdAt          DateTime @default(now()) @map("created_at")
  bet                Bet      @relation(fields: [betId], references: [id], onDelete: Cascade)

  @@map("clv_records")
}
